# KubeAI Environment Configuration
# Copy to .env and fill in your values

# ── PostgreSQL ──────────────────────────────────────────────────────────
POSTGRES_DB=kubeai
POSTGRES_USER=kubeai
POSTGRES_PASSWORD=kubeai_dev
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── ChromaDB ────────────────────────────────────────────────────────────
CHROMA_PORT=8000

# ── Prometheus ──────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ── Grafana ─────────────────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Airflow ─────────────────────────────────────────────────────────────
AIRFLOW_PORT=8081
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FERNET_KEY=

# ── LLM Provider API Keys (set the ones you use) ───────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# ── KubeAI Runtime ─────────────────────────────────────────────────────
KUBEAI_API_PORT=8080
KUBEAI_MODELS_CONFIG=
